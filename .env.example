# Required: Vapi public API key (browser-safe)
VAPI_PUBLIC_KEY=your_vapi_public_key_here

# Required: Vapi assistant IDs for the two voice agents
VAPI_FRONT_DESK_ASSISTANT_ID=your_front_desk_assistant_id
VAPI_DISPATCH_ASSISTANT_ID=your_dispatch_assistant_id

# Optional: backend endpoint for booking requests. Defaults to /api/book
# For local dev with Flask, set to http://localhost:5002/api/book or leave /api/book if proxied.
BOOKING_API_ENDPOINT=/api/book

# Optional: backend endpoint for booking requests when using n8n directly
# BOOKING_API_ENDPOINT=https://your-n8n-instance/webhook/avalimo-booking

# Optional: fallback phone number shown when transfer to live agent fails
VOICE_TRANSFER_PHONE=+18325678050

# Optional: analytics. Both are off when empty — no script is loaded and no
# event is sent. Set these as Coolify environment variables on the app; the
# entrypoint writes them into /__config.js, so no rebuild is needed to change
# or disable them.
# GA4: Google Analytics Admin > Data Streams > Web > Measurement ID
GA_MEASUREMENT_ID=
# Clarity: clarity.microsoft.com > Add new project > Project ID
CLARITY_PROJECT_ID=
