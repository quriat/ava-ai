# Required: Google AI Studio / Gemini API key
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Optional: override default booking email
BOOKING_EMAIL=adam@avalimo.net

# Optional: custom webhook URL for booking submissions (n8n, Zapier, Make, etc.)
# If provided, the form will POST JSON here instead of using formsubmit.co
BOOKING_WEBHOOK_URL=
