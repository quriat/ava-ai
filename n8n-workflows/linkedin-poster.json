{
  "name": "AvaLimo LinkedIn Poster",
  "nodes": [
    {
      "parameters": {},
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "avalimo-linkedin-post"
    },
    {
      "parameters": {
        "operation": "create",
        "resource": "post",
        "text": "={{ $json.text }}",
        "mediaUrls": "={{ $json.mediaUrls }}",
        "visibility": "={{ $json.visibility || 'PUBLIC' }}"
      },
      "id": "linkedin-post",
      "name": "Post to LinkedIn",
      "type": "n8n-nodes-base.linkedIn",
      "typeVersion": 1,
      "position": [500, 300],
      "credentials": {
        "linkedInOAuth2Api": "AvaLimo LinkedIn"
      }
    },
    {
      "parameters": {
        "chatId": "5820707923",
        "text": "LinkedIn post published: {{ $json.text }}",
        "options": {}
      },
      "id": "notify-telegram",
      "name": "Notify Adam",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1,
      "position": [750, 300],
      "credentials": {
        "telegramApi": "AvaLimo Telegram Bot"
      }
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Post to LinkedIn",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post to LinkedIn": {
      "main": [
        [
          {
            "node": "Notify Adam",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
